[ext_resource type="FontFile" path="res://Assets/Fonts/Tiny5/Tiny5.ttf" id="1_4vf7s"]
[ext_resource type="Script" path="res://Source/Systems/Display/font_face.gd" id="2_3o7ua"]

[resource]
script = ExtResource("2_3o7ua")
font = ExtResource("1_4vf7s")
size = 8
spacing_top = 4
note = "Small text in de, fr, es, pt_BR and ru (m3x6 has no accents or Cyrillic). Native size 8. Its own line is 9 px (7 above the baseline, 2 below), and accented capitals reach 9 above it; 4 px of top spacing make the line m3x6's 13 (11 above, 2 below), so text sits on English's baseline in every box and accents stay inside the line. Capitals are 5 px against m3x6's 6: text reads a pixel shorter than English."
