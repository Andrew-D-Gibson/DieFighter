[resource]
script = ExtResource("2_3o7ua")
font = ExtResource("1_4vf7s")
size = 8
note = "Small text in de, fr, es, pt_BR and ru (m3x6 has no accents or Cyrillic). Native size 8. Capitals are 5 px against m3x6's 6 and lines 9 px against 13, so text reads a pixel shorter than English. Accented capitals rise above the line box: C11b checks line spacing."
