# General ignores
Exports/

# Old DebugLogger output from when it wrote to res://; it now writes to
# user://debug_log.txt, outside the project.
debug_log.txt

# Written to the project root by the Godot MCP server on every run_project.
# The autoload uses Source/Systems/Autoloads/mcp_interaction_server.gd.
/mcp_interaction_server.gd
/mcp_interaction_server.gd.uid


# Godot-specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Per-locale hand-off files written by tools/loc.sh export; what matters
# comes back into the CSVs on import.
Localization/pending/

# Mac-specific ignores
*.DS_Store

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# AutoPilot run output (tools/autoplay.sh)
.autoplay/

# Python bytecode and virtual environment
__pycache__/
.venv/

# AI agent working folders (worktrees, plans, tool config). Files under
# .claude/ that were already tracked (settings.json) stay tracked.
.claude/
.codex/
.pi/

# Local reference art, not shipped
Assets/Inspiration Resources/

# FL Studio autosaves and backup renders. Each folder also holds a
# .gdignore so Godot doesn't import them.
Assets/Music/**/Backup/
Assets/Music/**/*_Backup/

# Personal tool and agent configs (absolute paths on one machine)
.mcp.json
opencode.jsonc
.skills.json
