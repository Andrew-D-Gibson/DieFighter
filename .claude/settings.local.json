{
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read_file",
      "Search",
      "List_dir",
      "Read(**/*.gd)",
      "Write(**/*.gd)",
      "Bash"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(git push*)"
    ],
    "ask": [
      "Write_file"
    ],
    "defaultMode": "acceptEdits"
  }
}
