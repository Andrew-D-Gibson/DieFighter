{
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read_file",
      "Search",
      "List_dir",
      "Read(**/*.gd)",
      "Write(**/*.gd)",
      "Bash",
      "mcp__godot-mcp-docs__get_documentation_file"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(git push*)"
    ],
    "ask": [
      "Write_file"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": [
    "godot-mcp-docs",
    "godot",
    "aseprite"
  ],
  "skillOverrides": {}
}
