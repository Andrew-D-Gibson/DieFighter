[resource]
script = ExtResource("1_h772t")
title = "Phased"
rule = "The next hit from the player's tiles passes through this ship and deals no [color=red]damage[/color], to shields or hull. Spends 1 Phased. Wears off when its turn starts."
player_rule = "The next enemy hit passes through you and deals no [color=red]damage[/color], to shields or hull. Spends 1 Phased. Wears off when your next turn starts."
tokens = Array[ExtResource("2_y14ai")]([SubResource("phased"), SubResource("phased_you")])
