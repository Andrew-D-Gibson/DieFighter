max_money_pickup = 20

[sub_resource type="Resource" id="outrigger_earned"]
script = ExtResource("condition")
test = 6
ship = &"outrigger"

[resource]
script = ExtResource("scenario")
map_icon = ExtResource("icon")
background_resource = ExtResource("backgrounds")
