max_money = 14
num_of_rewards = 0

[sub_resource type="Resource" id="courier_reward"]
script = ExtResource("reward")
min_money = 0
max_money = 0
num_of_rewards = 0

[sub_resource type="Resource" id="courier_spawn"]
script = ExtResource("spawn")
