rewards = Dictionary[int, ExtResource("reward")]({
1: SubResource("wreck")
})
starting_reward = SubResource("down_payment")
starting_reward_position = Vector2(230, 60)
sectors = 2
standing_requirements = Array[ExtResource("condition")]([SubResource("outrigger_earned")])
