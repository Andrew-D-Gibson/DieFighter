[resource]
script = ExtResource("script_tile")
tile_name = "[color=red]Broadside[/color]"
description = "[color=yellow]Any die[/color] -> Deal [color=red]3 damage[/color] to [color=purple]target[/color] for every die still in your hand, then [color=orange]give[/color] them the die"
hint_text = "Fire it first."
rarity = 1
textures = SubResource("SpriteFrames_tile")
uses_per_turn = 1
activation_checks = Array[ExtResource("script_act")]([SubResource("Resource_act_20"), SubResource("Resource_act_21")])
effect_chain = SubResource("Resource_chain_19")
