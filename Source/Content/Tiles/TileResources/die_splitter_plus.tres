[resource]
script = ExtResource("script_tile")
tile_name = "[color=green]Die Splitter+[/color]"
description = "[color=yellow]Die above[/color] (die_1) -> Split die in two: die keeps half (rounded up), a (hologram) gets the rest. [color=orange]Return[/color] both"
offered_as_reward = false
is_upgrade = true
textures = SubResource("SpriteFrames_tile")
uses_per_turn = 2
activation_checks = Array[ExtResource("script_act")]([SubResource("Resource_any_die"), SubResource("Resource_faces")])
effect_chain = SubResource("Resource_chain")
