[resource]
script = ExtResource("2_tile")
tile_name = "[color=purple]Ram Scoop[/color]"
description = "[color=yellow]Any die[/color] -> Gain [color=purple]2 engine charge[/color] for every [color=yellow]empty cell[/color] touching this tile, then [color=orange]give[/color] them the die"
