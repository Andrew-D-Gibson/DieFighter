[resource]
script = ExtResource("script_tile")
tile_name = "[color=red]Turncoat Cannon[/color]"
description = "(die_5) or (die_6) -> Deal [color=red]4 damage[/color] to [color=purple]target[/color], or [color=red]10[/color] if they are (scrambled). Then [color=orange]give[/color] them the die"
hint_text = "Hand them a six they'll read as a one."
rarity = 1
textures = SubResource("SpriteFrames_tile")
uses_per_turn = -1
activation_checks = Array[ExtResource("script_act")]([SubResource("Resource_act_1"), SubResource("Resource_act_2"), SubResource("Resource_act_3")])
effect_chain = SubResource("Resource_chain_17")
metadata/_custom_type_script = "uid://dtwktwiuvyqjh"
