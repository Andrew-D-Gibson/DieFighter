[resource]
script = ExtResource("script_tile")
offered_as_reward = false
is_upgrade = true
tile_name = "[color=red]Pair Lock+[/color]"
description = "[color=yellow]Any die[/color] -> [color=orange]Hold[/color] die. [color=yellow]Next die that matches it[/color]: Deal [color=red]damage[/color] to [color=purple]target[/color] equal to 5x die. [color=orange]Give[/color] both"
rarity = 1
textures = SubResource("SpriteFrames_tile")
uses_per_turn = 1
activation_checks = Array[ExtResource("script_act")]([SubResource("Resource_act_1"), SubResource("Resource_act_2"), SubResource("Resource_act_3")])
effect_chain = SubResource("Resource_chain")
holds_first_die = true
metadata/_custom_type_script = "uid://dtwktwiuvyqjh"
