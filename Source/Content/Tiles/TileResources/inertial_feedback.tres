[resource]
script = ExtResource("script_0")
tile_name = "[color=red]Inertial Feedback[/color]"
description = "(die_6) -> Deal [color=red]1 damage[/color] to [color=purple]all other ships[/color] per tile moved this combat ([data]tiles_moved[/data]), then reset the count. [color=orange]Gives[/color] the die to a [color=purple]random enemy[/color]"
rarity = 2
textures = SubResource("Resource_frames4")
uses_per_combat = -1
activation_checks = Array[ExtResource("script_1")]([SubResource("Resource_act1"), SubResource("Resource_act2"), SubResource("Resource_act3")])
