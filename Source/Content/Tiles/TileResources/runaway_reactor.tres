[resource]
script = ExtResource("script_0")
tile_name = "[color=purple]Runaway Reactor[/color]"
description = "[color=yellow]Takes no dice.[/color] At the start of your turn, if [color=red]overcharged[/color]: deal [color=red]5 damage[/color] to a [color=purple]random enemy[/color] and [color=red]2[/color] to your own hull"
hint_text = "It does not care that the surplus was meant for leaving."
rarity = 2
textures = SubResource("Resource_frames2")
uses_per_combat = -1
activation_checks = Array[ExtResource("script_1")]([SubResource("Resource_act1")])
effect_chain = SubResource("Resource_p_chain")
event_responses = Dictionary[ExtResource("script_7"), ExtResource("script_5")]({
SubResource("Resource_evt"): SubResource("Resource_r_chain")
})
metadata/_custom_type_script = "uid://dtwktwiuvyqjh"
