[resource]
script = ExtResource("script_0")
tile_name = "[color=purple]Brownout Plating[/color]"
description = "[color=yellow]Takes no dice.[/color] At the end of every [color=purple]enemy turn[/color], gain [color=blue]4 shields[/color] — but only while the engine is [color=purple]not charged[/color]"
hint_text = "It armours a ship that isn't going anywhere."
