[resource]
script = ExtResource("script_2")
enemy_name = "Zealot"
description = "Inbound lancer. Hits hard. Hand it more than its faith can hold in one turn and it [color=yellow]Overloads[/color]: no attack, every die vented home, and a burn through its own hull. Each overload raises the limit."
