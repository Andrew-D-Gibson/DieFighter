[resource]
script = ExtResource("script_2")
enemy_name = "Arc Dynamo"
faction = ExtResource("faction_identity")
description = "Reactor barge. Its biggest guns sit on its highest faces. Hand it more than its breaker can take in one turn and it [color=yellow]Overloads[/color]: no attack, every die vented home, and a jolt to its own hull. Each overload raises the limit."
max_health = 145
action_options = Array[ExtResource("script_1")]([SubResource("Resource_pool0"), SubResource("Resource_pool1")])
pool_selection = 1
face_bias = 1.5
overload_threshold = 15
overload_threshold_growth = 4
overload_chain = SubResource("Resource_chain")
overload_gauge_position = Vector2(0, 27)
ship_graphics_scene = ExtResource("gfx")
graphics_scene_offset = Vector2(0, -4)
dialogue_offset = Vector2(16, -8)
targeting_computer_image = ExtResource("tex")
health_bar_position = Vector2(-64, -5)
dice_queue_position = Vector2(56, 14)
formation_width = 100.0
metadata/_custom_type_script = "uid://cajjx3mskpg2e"
