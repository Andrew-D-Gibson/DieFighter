[resource]
script = ExtResource("script_2")
enemy_name = "Censer"
description = "Inbound thurible. Burns you with holy fire and passes its own burns on to you. Hand it more than it can hold in one turn and it (overload) [color=yellow]Overloads[/color]: no attack, every die vented home, and the fire turns inward. Each overload raises the limit."
faction = ExtResource("faction_identity")
max_health = 15
action_options = Array[ExtResource("script_1")]([SubResource("Resource_pool0")])
overload_threshold = 9
overload_threshold_growth = 3
overload_chain = SubResource("Resource_chain")
overload_warns_from_half = true
overload_gauge_position = Vector2(0, 21)
ship_graphics_scene = ExtResource("gfx")
dialogue_offset = Vector2(16, -8)
targeting_computer_image = ExtResource("tex")
health_bar_position = Vector2(-22, -12)
dice_queue_position = Vector2(26, 8)
metadata/_custom_type_script = "uid://cajjx3mskpg2e"
