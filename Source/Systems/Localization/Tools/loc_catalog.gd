class_name LocCatalog
extends RefCounted
## Every piece of content text in the project: each translatable field (see
## ContentText) of every resource saved under the scanned folders, including
## resources embedded inside another file, with the key it translates under.
##
## Content types aren't listed anywhere: a resource that implements
## ContentText's two methods is found wherever it lives.

## Where content lives. Only .tres files are read.
const DEFAULT_ROOTS: Array[String] = ["res://Source/"]


## One translatable field of one resource.
class Entry:
	extends RefCounted
	var key: String
	var english: String
	var context: String
	var max_chars: int
	## The .tres it was authored in.
	var source_path: String


## Entries by key.
var entries: Dictionary[String, Entry] = {}
## Problems that block a sync: two fields that generate the same key.
var problems: Array[String] = []


static func scan(roots: Array[String] = DEFAULT_ROOTS) -> LocCatalog:
	var catalog: LocCatalog = LocCatalog.new()
	var paths: Array[String] = []
	for root: String in roots:
		_find_tres(root, paths)
	paths.sort()
	for path: String in paths:
		var res: Resource = load(path)
		if res:
			catalog._visit(res, path, {})
	return catalog


## Sorted keys.
func keys() -> Array[String]:
	var sorted: Array[String] = []
	sorted.assign(entries.keys())
	sorted.sort()
	return sorted


func _visit(res: Resource, file_path: String, seen: Dictionary) -> void:
	if seen.has(res.get_instance_id()):
		return
	seen[res.get_instance_id()] = true

	for field: ContentText.Field in ContentText.fields_of(res):
		_add(res, field, file_path)

	# Embedded resources (a callout on an effect inside a tile's chain) are
	# content of this file. Ones saved as files of their own get scanned when
	# their own file comes up.
	for property: Dictionary in res.get_property_list():
		if not (property.usage & PROPERTY_USAGE_STORAGE):
			continue
		_visit_value(res.get(property.name), file_path, seen)


func _visit_value(value: Variant, file_path: String, seen: Dictionary) -> void:
	if value is Resource:
		var sub: Resource = value
		var sub_path: String = sub.resource_path
		if sub_path.is_empty() or sub_path.begins_with(file_path + "::"):
			_visit(sub, file_path, seen)
	elif value is Array:
		for item: Variant in value:
			_visit_value(item, file_path, seen)
	elif value is Dictionary:
		for item: Variant in (value as Dictionary).values():
			_visit_value(item, file_path, seen)


func _add(res: Resource, field: ContentText.Field, file_path: String) -> void:
	var english: String = str(res.get(field.property))
	# Nothing to translate; the game shows nothing (or its own fallback).
	if english.strip_edges().is_empty():
		return
	var key: String = ContentText.key_for(res, field.property)
	if key.is_empty():
		problems.append("%s: %s has no key (no resource path)" % [file_path, field.property])
		return
	if entries.has(key):
		var other: Entry = entries[key]
		if other.source_path != file_path:
			problems.append("%s: key %s is also generated by %s; rename one file" % [file_path, key, other.source_path])
		return
	var entry: Entry = Entry.new()
	entry.key = key
	entry.english = english
	entry.context = field.context
	entry.max_chars = field.max_chars
	entry.source_path = file_path
	entries[key] = entry


static func _find_tres(dir_path: String, found: Array[String]) -> void:
	var dir: DirAccess = DirAccess.open(dir_path)
	if dir == null:
		return
	for sub: String in dir.get_directories():
		if not sub.begins_with("."):
			_find_tres(dir_path.path_join(sub), found)
	for file: String in dir.get_files():
		if file.ends_with(".tres"):
			found.append(dir_path.path_join(file))
