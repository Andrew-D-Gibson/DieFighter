#!/bin/sh
# After a pull or merge, re-export the art that came in, so the PNGs in
# Assets/ match the .aseprite sources in Art/. Never blocks the merge.
cd "$(git rev-parse --show-toplevel)" || exit 0
python3 tools/export_art.py --since ORIG_HEAD ||
	echo "export_art failed; run python3 tools/export_art.py by hand" >&2
exit 0
