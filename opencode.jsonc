{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot-mcp-docs": {
      "type": "local",
      "enabled": true,
      "command": ["docker", "run", "--rm", "-i", "godot-mcp-docs:local"]
    },
    "godot": {
      "type": "local",
      "command": ["node", "/Users/drew/Documents/Godot/tools/godot-mcp/build/index.js"],
      "environment": {
        "GODOT_PATH": "/Users/drew/Documents/Godot/Godot_4.8_dev1.app/Contents/MacOS/Godot",
        "DEBUG": "true"
      },
      "enabled": true
    }
  }
}